# Runtime
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Persistence
DATABASE_PATH=data/learning_tutor.db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Fast connectivity probe; model generation has its own much longer timeout.
OLLAMA_CONNECT_TIMEOUT_SECONDS=8
OLLAMA_GENERATION_TIMEOUT_SECONDS=300
# Ordered from higher-quality local defaults to lighter fallbacks.
PREFERRED_MODELS=qwen3:8b,llama3.1:8b,gemma3:4b,qwen3:4b,llama3.2:3b
DISABLE_OLLAMA=false

# Browser session
SESSION_COOKIE_NAME=ai_tutor_session
SESSION_TIMEOUT_SECONDS=2592000
